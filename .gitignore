# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.aider*
.cursor/
test-results/
playwright-report/
.claude/settings.local.json

# supabase cli (estado local, no es del repo)
supabase/.temp/

# credenciales de las pruebas de humo y la sesion que guarda auth.setup.ts
.env.test.local
tests/.auth/

# ...pero el ejemplo SIN valores si se commitea: es la documentacion de que
# variables hacen falta. La regla `.env*` de arriba lo tapaba.
!.env.test.local.example

# respaldos de la base: son los datos del negocio, no del repositorio.
# El repo es privado, pero un repo privado no es una caja fuerte.
supabase/_respaldos/

# bot de gastos (AG-01): audios recibidos, log y cache de python
/bot/_audios/
/bot/*.log
/bot/__pycache__/
# El reloj de la espera del vigilante (D23): estado de ejecucion, no codigo.
/bot/vigilante_espera.txt

# v2 local: datos copiados de produccion (PII de clientes); nunca al repo
/supabase/seed_local/50_*.sql
/scripts/arranque_datos/*.json

# cache de python de los scripts
scripts/__pycache__/
# SQL generado del corte a produccion y su rollback: traen datos del negocio (2026-10-30)
supabase/_corte/*
# ...salvo el rollback: es solo DDL, sin datos, y tiene que vivir versionado
!supabase/_corte/down_v2.sql
