# Credenciales de las pruebas de humo. Copia este archivo a `.env.test.local`
# y pon ahi los valores reales.
#
#   cp .env.test.local.example .env.test.local
#   npm run test:humo
#
# `.env.test.local` esta en `.gitignore` y NUNCA se commitea. Este ejemplo si,
# porque solo lleva los nombres.
#
# Tiene que ser una cuenta con rol ADMIN: las dos pruebas de tableros y la de
# TKT-006 miran cifras que solo ve la matriz.

E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Opcional: si ya tienes `npm run dev` levantado, apunta aqui y Playwright no
# arranca otro servidor.
# E2E_BASE_URL=http://localhost:3000
