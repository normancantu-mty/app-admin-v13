      "admin_matriz_portion": {
        "rule": "ALWAYS rounds up.",
        "operator": "Math.ceil"
      },
      "node_distributor_portion": {
        "rule": "ALWAYS rounds down.",
        "operator": "Math.floor"
      },
      "complement_rule": "One leg is computed as exact complement of total to preserve ledger balance."
